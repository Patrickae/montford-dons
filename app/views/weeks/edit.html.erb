<% content_for :title, "Editing week" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing week</h1>
  <%= turbo_frame_tag dom_id(@week) do %>
    <%= render "form", week: @week %>
  <% end %>
  <%= link_to "Show this week", @week, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to weeks", weeks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
