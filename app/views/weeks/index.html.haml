- content_for :title, "Weeks"
.w-full.max-w-7xl.mx-auto
  - if notice.present?
    .bg-green-50.border.border-green-200.text-green-700.px-4.py-3.rounded-lg.mb-6.flex.items-center
      %svg.w-5.h-5.mr-2{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
        %path{d: "M5 13l4 4L19 7", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
      = notice
  / Header Section
  .bg-white.rounded-lg.shadow-sm.p-6.mb-6
    .flex.flex-col.sm:flex-row.justify-between.items-start.sm:items-center.gap-4
      %div
        %h1.text-3xl.font-bold.text-gray-900 Schedule
        %p.text-gray-600.mt-1 Manage weekly fixtures and bowling lanes
      = link_to new_week_path, class: "inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-sm transition-colors duration-200" do
        %svg.w-5.h-5.mr-2{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
          %path{d: "M12 6v6m0 0v6m0-6h6m-6 0H6", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
        New Week
  / Weeks List
  .bg-white.rounded-lg.shadow-sm.overflow-hidden
    - if @weeks.any?
      .divide-y.divide-gray-200
        - @weeks.each do |week|
          = turbo_frame_tag dom_id(week) do
            .p-6.hover:bg-gray-50.transition-colors.duration-150
              .flex.flex-col.lg:flex-row.lg:items-center.justify-between.gap-4
                / Week Info
                .flex-1
                  = render week
                / Actions
                .flex.flex-col.sm:flex-row.gap-2.lg:ml-6
                  = link_to week, class: "inline-flex items-center justify-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200" do
                    %svg.w-4.h-4.mr-1{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
                      %path{d: "M15 12a3 3 0 11-6 0 3 3 0 016 0z", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                      %path{d: "M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                    View
                  - if can? :update, week
                    = link_to edit_week_path(week), class: "inline-flex items-center justify-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200" do
                      %svg.w-4.h-4.mr-1{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
                        %path{d: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                      Edit
                  - if can? :destroy, week
                    = button_to week, method: :delete,                                                                                                                                                        |
                      class: "inline-flex items-center justify-center px-3 py-2 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-red-50 hover:bg-red-100 transition-colors duration-200", |
                      data: { turbo_confirm: "Are you sure you want to delete this week?" } do                                                                                                                |
                      %svg.w-4.h-4.mr-1{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
                        %path{d: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                      Delete
    - else
      .text-center.py-12
        %svg.mx-auto.h-12.w-12.text-gray-400{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
          %path{d: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
        %h3.mt-2.text-lg.font-medium.text-gray-900 No weeks scheduled
        %p.mt-1.text-gray-500 Get started by scheduling your first week.
        .mt-6
          = link_to new_week_path, class: "inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-sm transition-colors duration-200" do
            %svg.w-5.h-5.mr-2{fill: "none", stroke: "currentColor", viewbox: "0 0 24 24"}
              %path{d: "M12 6v6m0 0v6m0-6h6m-6 0H6", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
            Schedule First Week